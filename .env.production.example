# ==============================================================================
# EazyDoc Production Environment Configuration Template
# Copy this file to .env.production on the production host and populate secrets.
# NEVER commit .env.production or live secrets to version control.
# ==============================================================================

# Core Application Settings
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate a cryptographically random secret key (minimum 50 chars, base64 / hex)
SECRET_KEY=generate_a_cryptographically_secure_random_key_min_50_chars_for_production
ALLOWED_HOSTS=eazydoc.com,www.eazydoc.com,api.eazydoc.com,localhost,127.0.0.1,nginx,backend

# Network / Ports (Host Port Bindings)
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443

# PostgreSQL Database (Production Dedicated Instance / AWS RDS)
DATABASE_NAME=eazydoc_prod_db
DATABASE_USER=eazydoc_prod_user
DATABASE_PASSWORD=replace_with_strong_production_db_password_min_32_chars
DATABASE_HOST=db
DATABASE_PORT=5432
CONN_MAX_AGE=60

# Redis & Celery (Production Dedicated Instance / AWS ElastiCache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=https://eazydoc.com,https://www.eazydoc.com,https://api.eazydoc.com
CSRF_TRUSTED_ORIGINS=https://eazydoc.com,https://www.eazydoc.com,https://api.eazydoc.com

# SSL, HSTS & Security Cookies
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
JWT_AUTH_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# JWT Token Lifetimes
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Razorpay Production Gateway Configuration
# NOTE: Keep in test mode (rzp_test_...) during pilot verification.
# Switch to live keys (rzp_live_...) ONLY after explicit written human authorization.
RAZORPAY_KEY_ID=rzp_live_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_production_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_production_webhook_secret_key
RAZORPAY_CURRENCY=INR

# Platform Commission & Reservation Settings
PLATFORM_DEFAULT_COMMISSION_RATE=5.00
PAYMENT_RESERVATION_TIMEOUT_MINUTES=15

# Production Email Settings (SMTP Provider: Amazon SES / SendGrid / Postmark)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace_with_production_smtp_user
EMAIL_HOST_PASSWORD=replace_with_production_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EazyDoc Healthcare <noreply@eazydoc.com>

# Monitoring (Sentry Production DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_FORMAT=json

# AWS S3 Storage (Encrypted Cloud Object Storage for Media & Static)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=eazydoc-production-media
AWS_S3_REGION_NAME=ap-south-1
