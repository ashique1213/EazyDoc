# ==============================================================================
# EazyDoc Local Development Environment Configuration Template
# For Staging: see .env.staging.example
# For Production: see .env.production.example
# ==============================================================================

# Application
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-eazydoc-local-development-secret-key-replace-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL / SQLite toggle)
USE_SQLITE=False
DATABASE_NAME=eazydoc_db
DATABASE_USER=eazydoc_user
DATABASE_PASSWORD=eazydoc_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
CONN_MAX_AGE=0

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Razorpay (Payment Gateway - Test credentials for local development)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_not_used_in_day2
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_key
RAZORPAY_CURRENCY=INR

# Platform Commission & Reservation Settings
PLATFORM_DEFAULT_COMMISSION_RATE=5.00
PAYMENT_RESERVATION_TIMEOUT_MINUTES=15

# Email Settings (Console backend outputs emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=EazyDoc Healthcare <noreply@eazydoc.com>

# Monitoring (Optional local Sentry DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
LOG_FORMAT=verbose

# AWS / Storage (Optional for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
