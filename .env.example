# Application
DEBUG=True
SECRET_KEY=django-insecure-eazydoc-local-development-secret-key-replace-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DATABASE_NAME=eazydoc_db
DATABASE_USER=eazydoc_user
DATABASE_PASSWORD=eazydoc_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_not_used_in_day2
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_key
RAZORPAY_CURRENCY=INR

# Platform Commission & Reservation Settings
PLATFORM_DEFAULT_COMMISSION_RATE=5.00
PAYMENT_RESERVATION_TIMEOUT_MINUTES=15

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EazyDoc Healthcare <noreply@eazydoc.com>

# AWS / Storage (Optional for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
