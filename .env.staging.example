# ==============================================================================
# EazyDoc Staging Environment Configuration Template
# Copy this file to .env.staging and populate secrets before running staging containers.
# NEVER commit .env.staging or actual production secrets to version control.
# ==============================================================================

# Core Application Settings
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=generate_a_random_cryptographic_key_min_50_chars_for_staging
ALLOWED_HOSTS=localhost,127.0.0.1,staging.eazydoc.internal,staging.eazydoc.com,nginx,backend

# Network / Ports (Host Port Bindings)
STAGING_HTTP_PORT=80
STAGING_HTTPS_PORT=443

# PostgreSQL Database (Internal Staging Container)
DATABASE_NAME=eazydoc_staging_db
DATABASE_USER=eazydoc_staging_user
DATABASE_PASSWORD=replace_with_secure_staging_db_password
DATABASE_HOST=db
DATABASE_PORT=5432
CONN_MAX_AGE=60

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1,http://staging.eazydoc.internal,https://staging.eazydoc.internal
CSRF_TRUSTED_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1,http://staging.eazydoc.internal,https://staging.eazydoc.internal

# SSL & Security Cookies (Set to True if testing HTTPS exclusively)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
JWT_AUTH_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# JWT Token Lifetimes
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Razorpay Test Gateway Configuration (TEST KEYS ONLY!)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_staging
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_staging
RAZORPAY_CURRENCY=INR

# Platform Commission & Reservation Settings
PLATFORM_DEFAULT_COMMISSION_RATE=5.00
PAYMENT_RESERVATION_TIMEOUT_MINUTES=15

# Staging Email Settings (Console / Mailpit to prevent sending real messages)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=EazyDoc Staging <noreply-staging@eazydoc.com>

# Monitoring (Optional Sentry DSN for Staging)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# AWS S3 Storage (Optional in Staging; defaults to persistent local volume)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

